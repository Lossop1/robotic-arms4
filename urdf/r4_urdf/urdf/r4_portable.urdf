    <child link="link4"/>
    <origin xyz="0.24 -0.036 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159265" upper="3.14159265" effort="1" velocity="1"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>
  <joint name="tool_mount" type="fixed">
